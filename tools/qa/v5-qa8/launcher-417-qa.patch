+                published instanceof Boolean value ? value : null, List.copyOf(ids), memory instanceof Boolean local ? local : null);
+        }
+        public void send(String type, String text) throws Exception {
+            if (!(type.equals("chat") && NativeQaRequests.validChat(text)) &&
+                !(type.equals("command") && NativeQaRequests.validCommand(text))) throw new SecurityException("Unsafe native request");
