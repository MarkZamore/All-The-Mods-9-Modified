+package org.lwjgl.opengl;
+
+import org.lwjgl.QaGpuTracker;
+
+/** Only the authorized read-only enum queries exist in this fake API. */
+public final class GL11 {
+    static { QaGpuTracker.gl11Initializers++; }
+    public static int glGetInteger(int name) {
+        if (name != 3379) throw new AssertionError("Unauthorized GL integer enum: " + name);
+        QaGpuTracker.integerQueries++; return 16384;
+    }
+    public static String glGetString(int name) {
+        QaGpuTracker.stringQueries++;
+        return switch (name) {
+            case 7936 -> "standalone fake vendor";
+            case 7937 -> "standalone fake renderer";
+            case 7938 -> "standalone fake version";
+            default -> throw new AssertionError("Unauthorized GL string enum: " + name);
+        };
+    }
+}
