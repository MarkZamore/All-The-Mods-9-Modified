+/** Private protocol 5 requests. No automatic request, GUI, attachment or bytecode change. */
+final class NativeQaRequests {
+    static final int PROTOCOL = 5, BYTE_LIMIT = 4096, REQUEST_LIMIT = 32;
+    private static final Pattern ID = Pattern.compile("[a-z0-9][a-z0-9_-]{0,63}");
+    private static final Pattern WORLD = Pattern.compile("ATM9Qa[A-Za-z0-9_-]{0,48}");
+    private static final Pattern GIVE = Pattern.compile("give @s ([a-z0-9_.-]+:[a-z0-9_./-]+)(?: ([1-9]|[1-5][0-9]|6[0-4]))?");
+    record Request(String id, String type, String world, UUID playerUuid, String text) { }
+    record Facts(String world, UUID clientUuid, Boolean published, List<UUID> serverPlayers, Boolean localConnection) { }
+    interface Target { Facts inspect() throws Exception; void send(String type, String text) throws Exception; }
+    interface Events { void write(String kind, Map<String, ?> values) throws IOException; }
+
+    static boolean validId(String value) { return value != null && ID.matcher(value).matches(); }
+    static boolean validWorld(String value) { return value != null && WORLD.matcher(value).matches(); }
+    static boolean validChat(String value) {
+        if (value == null || value.isBlank() || value.length() > 256 || value.indexOf('/') >= 0) return false;
+        for (int i = 0; i < value.length(); i++) {
+            char c = value.charAt(i);
+            if (Character.isISOControl(c) || c == '\u2028' || c == '\u2029') return false;
+            if (Character.isHighSurrogate(c)) {
+                if (++i >= value.length() || !Character.isLowSurrogate(value.charAt(i))) return false;
+            } else if (Character.isLowSurrogate(c)) return false;
+        }
+        return true;
+    }
+    static boolean validCommand(String value) {
+        if (value == null) return false;
+        var match = GIVE.matcher(value);
+        return match.matches() && QaLifecycleAgent.NativeResourceProbe.validResourceId(match.group(1));
+    }
+    static UUID canonicalUuid(String text) {
+        UUID uuid = UUID.fromString(text);
+        if (!uuid.toString().equals(text)) throw new IllegalArgumentException("UUID must be canonical lowercase");
+        return uuid;
+    }
+    static Request parse(byte[] bytes, String filename) throws Exception {
+        if (bytes.length == 0 || bytes.length > BYTE_LIMIT) throw new IllegalArgumentException("Request exceeds byte limit");
+        String text = StandardCharsets.UTF_8.newDecoder().onMalformedInput(CodingErrorAction.REPORT)
+            .onUnmappableCharacter(CodingErrorAction.REPORT).decode(ByteBuffer.wrap(bytes)).toString();
+        Map<String, String> values = new FlatJson(text).read();
+        if (!values.keySet().equals(Set.of("protocol", "id", "type", "world", "playerUuid", "text")) ||
+            !"#5".equals(values.get("protocol"))) throw new IllegalArgumentException("Unknown request schema/protocol");
+        for (String key : List.of("id", "type", "world", "playerUuid", "text"))
+            if (!values.get(key).startsWith("$")) throw new IllegalArgumentException("Request field must be a string");
+        String id = values.get("id").substring(1), type = values.get("type").substring(1),
+            world = values.get("world").substring(1), message = values.get("text").substring(1);
+        if (!validId(id) || !filename.equals(id + ".json") || !validWorld(world)) throw new IllegalArgumentException("Unsafe request identity/world");
+        if (!(type.equals("chat") && validChat(message)) && !(type.equals("command") && validCommand(message)))
+            throw new IllegalArgumentException("Request permits only plain chat or strict give @s");
+        return new Request(id, type, world, canonicalUuid(values.get("playerUuid").substring(1)), message);
+    }
+    static void requireScope(Request request, String expectedWorld, UUID expectedUuid, Facts facts) {
+        if (!validWorld(expectedWorld) || expectedUuid == null || !request.world().equals(expectedWorld) ||
+            !request.playerUuid().equals(expectedUuid) || facts == null || !expectedWorld.equals(facts.world()) ||
+            !expectedUuid.equals(facts.clientUuid()) || !Boolean.FALSE.equals(facts.published()) || !Boolean.TRUE.equals(facts.localConnection()) ||
+            facts.serverPlayers() == null || facts.serverPlayers().size() != 1 || !expectedUuid.equals(facts.serverPlayers().get(0)))
+            throw new SecurityException("Request requires its exact private one-player disposable integrated world and offline QA UUID");
+    }
+
+    static final class Queue {
+        final Path directory;
+        final String expectedWorld;
+        final UUID expectedUuid;
+        final Set<String> terminal = new HashSet<>();
+        Queue(Path evidence, String expectedWorld, UUID expectedUuid) {
+            directory = evidence.resolve("native-requests"); this.expectedWorld = expectedWorld; this.expectedUuid = expectedUuid;
+        }
+        void process(boolean stableWorld, Target target, Events events) throws IOException {
+            if (!stableWorld || !Files.exists(directory, LinkOption.NOFOLLOW_LINKS)) return;
+            requireLocalDirectory(directory);
+            List<Path> requests;
+            try (var stream = Files.list(directory)) {
+                requests = stream.filter(path -> path.getFileName().toString().endsWith(".json")).sorted().limit(REQUEST_LIMIT + 1).toList();
+            }
+            if (requests.size() > REQUEST_LIMIT) throw new SecurityException("Too many explicit native requests");
+            for (Path path : requests) {
+                String filename = path.getFileName().toString();
+                if (!terminal.add(filename)) continue;
+                String id = filename.substring(0, filename.length() - 5);
+                if (!validId(id)) { events.write("native_request_refused", Map.of("id", "<invalid>", "reason", "Unsafe request filename", "nativeCallMade", false)); continue; }
+                Path claims = directory.resolve("claims");
+                Files.createDirectories(claims); requireLocalDirectory(claims);
+                Path claim = claims.resolve(id + ".claimed");
+                if (Files.exists(claim, LinkOption.NOFOLLOW_LINKS)) {
+                    events.write("native_request_replay_refused", Map.of("id", id, "nativeCallMade", false)); continue;
+                }
+                byte[] bytes;
+                try {
+                    if (!Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS) || !path.toRealPath().equals(path.toAbsolutePath().normalize()))
+                        throw new SecurityException("Linked/nonregular request rejected");
+                    try (var input = Files.newInputStream(path, LinkOption.NOFOLLOW_LINKS)) { bytes = input.readNBytes(BYTE_LIMIT + 1); }
+                } catch (Exception failure) {
+                    Files.writeString(claim, "unreadable request\n", StandardOpenOption.CREATE_NEW);
+                    events.write("native_request_refused", Map.of("id", id, "reason", bounded(failure), "nativeCallMade", false)); continue;
+                }
+                String sha;
+                try { sha = HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(bytes)); }
+                catch (Exception failure) { throw new IOException(failure); }
+                // At most one dispatch attempt, including after failure/restart. Never retry a claimed request.
+                try { Files.writeString(claim, sha + "\n", StandardOpenOption.CREATE_NEW); }
+                catch (FileAlreadyExistsException replay) { events.write("native_request_replay_refused", Map.of("id", id, "nativeCallMade", false)); continue; }
+                events.write("native_request_requested", Map.of("id", id, "requestSha256", sha, "automatic", false));
+                Request request;
+                try {
+                    request = parse(bytes, filename);
+                    requireScope(request, expectedWorld, expectedUuid, target.inspect());
+                    // Recheck immediately before the ordinary native packet call; unknown state refuses.
+                    requireScope(request, expectedWorld, expectedUuid, target.inspect());
+                } catch (Exception failure) {
+                    events.write("native_request_refused", Map.of("id", id, "requestSha256", sha, "reason", bounded(failure), "nativeCallMade", false)); continue;
+                }
+                try {
+                    target.send(request.type(), request.text());
+                    events.write("native_request_executed", Map.of("id", id, "requestSha256", sha, "type", request.type(),
+                        "text", request.text(), "world", request.world(), "nativeMethod", request.type().equals("chat") ? "ClientPacketListener.m_246175_" : "ClientPacketListener.m_246623_",
+                        "nativeCallReturned", true, "serverEffectVerified", false, "visualInputUsed", false));
+                } catch (Exception failure) {
+                    events.write("native_request_failed_after_claim", Map.of("id", id, "requestSha256", sha, "reason", bounded(failure), "retryAllowed", false));
+                }
+            }
+        }
+        private static void requireLocalDirectory(Path path) throws IOException {
+            if (!Files.isDirectory(path, LinkOption.NOFOLLOW_LINKS) || !path.toRealPath().equals(path.toAbsolutePath().normalize()))
+                throw new SecurityException("Linked/nonlocal native request directory rejected");
+        }
+    }
+
+    /** Flat strict JSON only; no Gson or early game-class lookup is needed. */
+    private static final class FlatJson {
+        final String text; int offset;
+        FlatJson(String text) { this.text = text; }
+        Map<String, String> read() {
+            var values = new LinkedHashMap<String, String>(); ws(); take('{'); ws();
+            if (peek('}')) throw new IllegalArgumentException("Empty request");
+            while (true) {
+                String key = string(); ws(); take(':'); ws();
+                String value;
+                if (peek('"')) value = "$" + string();
+                else { int start = offset; while (offset < text.length() && Character.isDigit(text.charAt(offset))) offset++;
+                    if (offset == start) throw new IllegalArgumentException("Flat scalar request only"); value = "#" + text.substring(start, offset); }
+                if (values.putIfAbsent(key, value) != null) throw new IllegalArgumentException("Duplicate JSON key");
+                ws(); if (peek('}')) { offset++; break; } take(','); ws();
+            }
+            ws(); if (offset != text.length()) throw new IllegalArgumentException("Trailing JSON content"); return values;
+        }
+        String string() {
+            take('"'); var result = new StringBuilder();
+            while (offset < text.length()) {
+                char c = text.charAt(offset++); if (c == '"') return result.toString();
+                if (c < 32) throw new IllegalArgumentException("Unescaped JSON control");
+                if (c == '\\') {
+                    if (offset >= text.length()) throw new IllegalArgumentException("Truncated escape");
+                    char escape = text.charAt(offset++);
+                    c = switch (escape) {
+                        case '"', '\\', '/' -> escape; case 'b' -> '\b'; case 'f' -> '\f'; case 'n' -> '\n'; case 'r' -> '\r'; case 't' -> '\t';
+                        case 'u' -> { if (offset + 4 > text.length()) throw new IllegalArgumentException("Truncated Unicode escape");
+                            String hex = text.substring(offset, offset + 4);
+                            if (!hex.matches("[0-9A-Fa-f]{4}")) throw new IllegalArgumentException("Invalid Unicode escape");
+                            int code = Integer.parseInt(hex, 16); offset += 4; yield (char) code; }
+                        default -> throw new IllegalArgumentException("Invalid JSON escape");
+                    };
+                }
+                result.append(c);
+            }
+            throw new IllegalArgumentException("Unterminated JSON string");
+        }
+        void ws() { while (offset < text.length() && " \t\r\n".indexOf(text.charAt(offset)) >= 0) offset++; }
+        boolean peek(char c) { return offset < text.length() && text.charAt(offset) == c; }
+        void take(char c) { if (!peek(c)) throw new IllegalArgumentException("Malformed JSON request"); offset++; }
+    }
+    private static String bounded(Exception failure) {
+        while (failure instanceof InvocationTargetException && failure.getCause() instanceof Exception nested) failure = nested;
+        String message = failure.getClass().getSimpleName() + ": " + String.valueOf(failure.getMessage());
+        return message.length() <= 512 ? message : message.substring(0, 512);
+    }
+}
diff --git a/tools/Atm9OriginalQa/QaNativeRequests.cs b/tools/Atm9OriginalQa/QaNativeRequests.cs
new file mode 100644
index 0000000..fde078b
--- /dev/null
+++ b/tools/Atm9OriginalQa/QaNativeRequests.cs
@@ -0,0 +1,118 @@
+using System.IO;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using System.Text.RegularExpressions;
+
+static class QaNativeRequests
+{
+    internal const int Protocol = 5, ByteLimit = 4096, RequestLimit = 32;
+    internal static bool ValidId(string value) => Regex.IsMatch(value, @"\A[a-z0-9][a-z0-9_-]{0,63}\z");
+    internal static bool ValidWorld(string value) => Regex.IsMatch(value, @"\AATM9Qa[A-Za-z0-9_-]{0,48}\z");
+    internal static bool ValidQaName(string value) => Regex.IsMatch(value, @"\AATM9Qa[A-Za-z0-9_]{0,10}\z");
+    internal static Guid OfflineUuid(string name)
+    {
+        var bytes = MD5.HashData(Encoding.UTF8.GetBytes("OfflinePlayer:" + name));
+        bytes[6] = (byte)((bytes[6] & 15) | 48); bytes[8] = (byte)((bytes[8] & 63) | 128);
+        return new Guid(bytes, bigEndian: true);
+    }
+    internal static void RequireLaunchScope(int protocol, bool integrated, bool offlineIdentity,
+        string world, string playerName, string uuid)
+    {
+        if (protocol != Protocol)
+            throw new IOException("Native requests require a fresh launch with the v5 agent. A running older agent cannot be upgraded in place.");
+        if (!integrated || !offlineIdentity || !ValidWorld(world) || !ValidQaName(playerName) ||
+            !Guid.TryParseExact(uuid, "D", out var parsed) || parsed.ToString("D") != uuid || OfflineUuid(playerName) != parsed)
+            throw new IOException("Native requests require the exact reserved world and offline QA identity of an integrated fixture.");
+    }
+    internal static bool ValidChat(string value)
+    {
+        if (string.IsNullOrWhiteSpace(value) || value.Length > 256 || value.Contains('/')) return false;
+        for (var i = 0; i < value.Length; i++)
+        {
+            var c = value[i];
+            if (char.IsControl(c) || c is '\u2028' or '\u2029') return false;
+            if (char.IsHighSurrogate(c)) { if (++i >= value.Length || !char.IsLowSurrogate(value[i])) return false; }
+            else if (char.IsLowSurrogate(c)) return false;
+        }
+        return true;
+    }
+    internal static bool ValidCommand(string value)
+    {
+        var match = Regex.Match(value, @"\Agive @s ([a-z0-9_.-]+:[a-z0-9_./-]+)(?: ([1-9]|[1-5][0-9]|6[0-4]))?\z");
+        if (!match.Success || match.Groups[1].Value.Length > 256) return false;
+        var path = match.Groups[1].Value.Split(':')[1];
+        return !path.Split('/').Any(part => part is "" or "." or "..");
+    }
+    internal static bool Write(string evidence, string id, string type, string world, string uuid, string text)
+    {
+        if (!ValidId(id) || !ValidWorld(world) || !Guid.TryParseExact(uuid, "D", out var parsed) || parsed.ToString("D") != uuid ||
+            !(type == "chat" && ValidChat(text)) && !(type == "command" && ValidCommand(text)))
+            throw new ArgumentException("Only a safe ID, exact QA scope, plain chat or strict give @s command is accepted.");
+        var bytes = JsonSerializer.SerializeToUtf8Bytes(new { protocol = Protocol, id, type, world, playerUuid = uuid, text });
+        if (bytes.Length > ByteLimit) throw new ArgumentException("Native request exceeds its byte limit.");
+        var queue = Path.Combine(evidence, "native-requests");
+        RejectLinks(queue); Directory.CreateDirectory(queue); RejectLinks(queue);
+        var destination = Path.Combine(queue, id + ".json");
+        RejectLinks(destination);
+        if (File.Exists(destination))
+        {
+            if (new FileInfo(destination).Length <= ByteLimit && File.ReadAllBytes(destination).AsSpan().SequenceEqual(bytes)) return false;
+            throw new IOException("Request ID already exists with different content; it cannot be overwritten or replayed.");
+        }
+        if (Directory.EnumerateFiles(queue, "*.json", SearchOption.TopDirectoryOnly).Take(RequestLimit).Count() >= RequestLimit)
+            throw new IOException("Native request limit reached.");
+        var temporary = Path.Combine(queue, ".pending-" + Guid.NewGuid().ToString("N") + ".tmp");
+        try
+        {
+            using (var stream = new FileStream(temporary, FileMode.CreateNew, FileAccess.Write, FileShare.None))
+            { stream.Write(bytes); stream.Flush(flushToDisk: true); }
+            File.Move(temporary, destination, overwrite: false);
+        }
+        finally { if (File.Exists(temporary)) File.Delete(temporary); }
+        return true;
+    }
+    private static void RejectLinks(string path)
+    {
+        for (string? current = Path.GetFullPath(path); current is not null; current = Path.GetDirectoryName(current))
+            if ((File.Exists(current) || Directory.Exists(current)) && (File.GetAttributes(current) & FileAttributes.ReparsePoint) != 0)
+                throw new IOException("Linked native request paths are forbidden.");
+    }
+    internal static object SelfTest(string output)
+    {
+        if (Directory.Exists(output)) throw new IOException("Use a new standalone request-test output directory.");
+        int checks = 0;
+        void Check(bool value, string message) { checks++; if (!value) throw new InvalidOperationException(message); }
+        void Rejected(Action action, string message)
+        { var rejected = false; try { action(); } catch (ArgumentException) { rejected = true; } catch (IOException) { rejected = true; } Check(rejected, message); }
+        const string world = "ATM9QaNativeRequests";
+        var uuid = OfflineUuid("ATM9Qa").ToString("D");
+        RequireLaunchScope(5, true, true, world, "ATM9Qa", uuid); Check(true, "Valid scope");
+        foreach (var protocol in new[] { 2, 3, 4, 6 }) Rejected(() => RequireLaunchScope(protocol, true, true, world, "ATM9Qa", uuid), "Wrong protocol accepted");
+        Rejected(() => RequireLaunchScope(5, false, true, world, "ATM9Qa", uuid), "Baseline accepted");
+        Rejected(() => RequireLaunchScope(5, true, false, world, "ATM9Qa", uuid), "Account identity accepted");
+        Rejected(() => RequireLaunchScope(5, true, true, "PersonalWorld", "ATM9Qa", uuid), "Personal world accepted");
+        Rejected(() => RequireLaunchScope(5, true, true, world, "Oscar", uuid), "Non-QA name accepted");
+        Rejected(() => RequireLaunchScope(5, true, true, world, "ATM9Qa", Guid.Empty.ToString("D")), "Wrong UUID accepted");
+        Check(!Directory.Exists(output), "Scope refusal created files");
+        foreach (var text in new[] { "Верити, ответь по-русски.", new string('я', 256), "Проверка 🙂" }) Check(ValidChat(text), "Valid chat rejected");
+        foreach (var text in new[] { "", " ", "/give @s minecraft:stone", "a/b", "a\nb", "a\rb", "a\tb", "a\0b", "a\u2028b", "a\u2029b", new string('я', 257), "\uD800", "\uDC00" })
+            Check(!ValidChat(text), "Unsafe chat accepted");
+        foreach (var text in new[] { "give @s verity:verity_item", "give @s minecraft:stone 1", "give @s test:path/item 64" }) Check(ValidCommand(text), "Valid give rejected");
+        foreach (var text in new[] { "give @a minecraft:stone", "give @e minecraft:stone", "give Oscar minecraft:stone", "/give @s minecraft:stone", "give @s minecraft:stone 0", "give @s minecraft:stone 65", "give @s minecraft:stone 01", "give @s minecraft:stone -1", "give @s minecraft:stone 1\n", "give @s minecraft:stone;stop", "give @s minecraft:stone{}", "give @s minecraft:stone[x=1]", "give @s minecraft:stone 1 extra", "give @s test:../a", "give @s test:a//b", "say test", "op @s", "give  @s minecraft:stone" })
+            Check(!ValidCommand(text), "Unsafe command accepted");
+        Rejected(() => Write(output, "../bad", "chat", world, uuid, "test"), "Traversal ID accepted");
+        Check(!Directory.Exists(output), "Bad request created files");
+        Check(Write(output, "001-chat", "chat", world, uuid, "Верити, ответь по-русски."), "Request was not created");
+        var destination = Path.Combine(output, "native-requests", "001-chat.json");
+        var before = File.ReadAllBytes(destination); var timestamp = File.GetLastWriteTimeUtc(destination);
+        Check(!Write(output, "001-chat", "chat", world, uuid, "Верити, ответь по-русски."), "Identical ID was written twice");
+        Check(timestamp == File.GetLastWriteTimeUtc(destination) && File.ReadAllBytes(destination).AsSpan().SequenceEqual(before), "Idempotent write changed request");
+        Rejected(() => Write(output, "001-chat", "command", world, uuid, "give @s minecraft:stone"), "ID reused for different action");
+        Check(File.ReadAllBytes(destination).AsSpan().SequenceEqual(before), "Changed replay overwrote request");
+        Check(!Directory.EnumerateFiles(Path.GetDirectoryName(destination)!, "*.tmp").Any(), "Partial request survived atomic write");
+        for (var i = 1; i < RequestLimit; i++) Write(output, "chat-" + i, "chat", world, uuid, "test");
+        Rejected(() => Write(output, "overflow", "chat", world, uuid, "test"), "Queue bound ignored");
+        return new { status = "PASS", checks, gameInteraction = false, requestProtocol = Protocol, currentGameInteraction = false };
+    }
+}
diff --git a/tools/Atm9OriginalQa/QaProcessIdentity.cs b/tools/Atm9OriginalQa/QaProcessIdentity.cs
new file mode 100644
index 0000000..e898ec9
--- /dev/null
+++ b/tools/Atm9OriginalQa/QaProcessIdentity.cs
@@ -0,0 +1,116 @@
+using System.Diagnostics;
+using System.IO;
+using System.Text.Json;
+
+record Run(int ProcessId, DateTimeOffset StartedAtUtc, string GameDirectory, string Mode, string Label,
+    DateTimeOffset? ProcessCreatedAtUtc = null, string? ExpectedProcessName = null);
+record QaExit(int ProcessId, int ExitCode, DateTimeOffset ExitedAtUtc);
+record QaProcessSnapshot(string Name, DateTimeOffset CreatedAtUtc, bool HasExited);
+record QaProcessStatus(bool IsRunning, string State, string Authority,
+    DateTimeOffset? ObservedCreatedAtUtc = null, string? ObservedProcessName = null);
+
+// Read-only process metadata. No attach, input, termination or process-tree operations.
+static class QaProcessIdentity
+{
+    private static readonly JsonSerializerOptions Json = new() { PropertyNameCaseInsensitive = true };
+
+    public static QaProcessStatus Read(Run run, string evidence)
+    {
+        var exitPath = Path.Combine(evidence, "exit.json");
+        QaExit? terminal = null;
+        if (File.Exists(exitPath))
+        {
+            try { terminal = JsonSerializer.Deserialize<QaExit>(File.ReadAllText(exitPath), Json) ?? throw new JsonException("Empty exit record."); }
+            catch (JsonException failure) { throw new IOException("QA exit.json is incomplete or malformed. Wait for its writer or review this fixture; no control marker was written.", failure); }
+        }
+        return Evaluate(run, terminal, DateTimeOffset.UtcNow, ReadProcess);
+    }
+
+    internal static QaProcessStatus Evaluate(Run run, QaExit? terminal, DateTimeOffset now, Func<int, QaProcessSnapshot?> resolve)
+    {
+        if (run.ProcessId <= 0 || run.StartedAtUtc == default || run.StartedAtUtc > now.AddMinutes(1))
+            throw new IOException("QA run.json has an invalid process ID or launch timestamp; review this fixture before controlling it.");
+        if (terminal is not null)
+        {
+            if (terminal.ProcessId != run.ProcessId || terminal.ExitedAtUtc < (run.ProcessCreatedAtUtc ?? run.StartedAtUtc) || terminal.ExitedAtUtc > now.AddMinutes(1))
+                throw new IOException("QA exit.json does not match run.json process ID/time. Review the conflicting evidence; no control marker was written.");
+            // Do not query a historical PID: Windows may have reused it or may
+            // retain a terminated process object while another reader holds it.
+            return new(false, "terminal", "matching exit.json");
+        }
+        var actual = resolve(run.ProcessId);
+        if (actual is null) return new(false, "absent", "process metadata");
+        if (!IsJava(actual.Name) || (run.ExpectedProcessName is not null &&
+            !actual.Name.Equals(run.ExpectedProcessName, StringComparison.OrdinalIgnoreCase)))
+            return new(false, "process-name-mismatch", "PID is not the recorded QA Java", actual.CreatedAtUtc, actual.Name);
+        var expectedStart = run.ProcessCreatedAtUtc ?? run.StartedAtUtc;
+        // New records retain the actual OS creation time. Legacy records were
+        // stamped just before CreateProcess and need a small launch tolerance.
+        var tolerance = run.ProcessCreatedAtUtc is null ? TimeSpan.FromSeconds(2) : TimeSpan.FromMilliseconds(1);
+        if ((actual.CreatedAtUtc - expectedStart).Duration() > tolerance)
+            return new(false, "process-start-mismatch", "PID is not the recorded QA Java", actual.CreatedAtUtc, actual.Name);
+        return new(!actual.HasExited, actual.HasExited ? "exited" : "active", "matching Java name and OS creation time", actual.CreatedAtUtc, actual.Name);
+    }
+
+    private static bool IsJava(string name) => name.Equals("java", StringComparison.OrdinalIgnoreCase) || name.Equals("javaw", StringComparison.OrdinalIgnoreCase);
+
+    private static QaProcessSnapshot? ReadProcess(int pid)
+    {
+        Process process;
+        try { process = Process.GetProcessById(pid); }
+        catch (ArgumentException) { return null; }
+        using (process)
+        {
+            try { return new(process.ProcessName, new DateTimeOffset(process.StartTime.ToUniversalTime()), process.HasExited); }
+            catch (Exception failure) when (failure is InvalidOperationException or System.ComponentModel.Win32Exception)
+            {
+                throw new IOException("Cannot verify the recorded QA Java process identity. Retry the same fixture or inspect its exit evidence; no control marker was written.", failure);
+            }
+        }
+    }
+
+    public static object SelfTest(string output)
+    {
+        if (Directory.Exists(output)) throw new IOException("Use a new artifacts output for the process identity self-test.");
+        Directory.CreateDirectory(output);
+        using var own = Process.GetCurrentProcess();
+        var now = DateTimeOffset.UtcNow;
+        var ownStart = new DateTimeOffset(own.StartTime.ToUniversalTime());
+        var run = new Run(own.Id, ownStart, "standalone CLI self-test", "self-test", "identity");
+        var ownSnapshot = new QaProcessSnapshot(own.ProcessName, ownStart, own.HasExited);
+        var checks = 0;
+        void Check(bool condition, string reason) { checks++; if (!condition) throw new InvalidOperationException(reason); }
+        void Reject(Action action, string reason)
+        {
+            var rejected = false;
+            try { action(); } catch (IOException) { rejected = true; }
+            Check(rejected, reason);
+        }
+        Check(!Evaluate(run, null, now, _ => ownSnapshot).IsRunning, "Own dotnet test process must not be accepted as QA Java.");
+        var javaFixture = new QaProcessSnapshot("javaw", ownStart, false);
+        Check(Evaluate(run, null, now, _ => javaFixture).IsRunning, "Matching legacy Java identity rejected.");
+        Check(!Evaluate(run, null, now, _ => javaFixture with { CreatedAtUtc = ownStart.AddSeconds(3) }).IsRunning, "Reused PID with different start time accepted.");
+        Check(!Evaluate(run, null, now, _ => javaFixture with { Name = "unrelated" }).IsRunning, "Reused PID with different image accepted.");
+        Check(!Evaluate(run, null, now, _ => null).IsRunning, "Missing PID accepted as active.");
+        var exact = run with { ProcessCreatedAtUtc = ownStart, ExpectedProcessName = "javaw" };
+        Check(Evaluate(exact, null, now, _ => javaFixture).IsRunning, "Matching exact creation time rejected.");
+        Check(!Evaluate(exact, null, now, _ => javaFixture with { CreatedAtUtc = ownStart.AddMilliseconds(2) }).IsRunning, "Different exact creation time accepted.");
+        Check(!Evaluate(exact, null, now, _ => javaFixture with { Name = "java" }).IsRunning, "Different recorded Java executable name accepted.");
+        var exit = new QaExit(own.Id, 0, now);
+        var lookups = 0;
+        var terminal = Evaluate(run, exit, now, _ => { lookups++; throw new InvalidOperationException("Historical PID must never be resolved."); });
+        Check(!terminal.IsRunning && terminal.State == "terminal" && lookups == 0, "Matching exit did not take precedence over a potentially reused PID.");
+        Reject(() => Evaluate(run, exit with { ProcessId = own.Id + 1 }, now, _ => javaFixture), "Mismatched terminal PID accepted.");
+        Reject(() => Evaluate(run, exit with { ExitedAtUtc = ownStart.AddTicks(-1) }, now, _ => javaFixture), "Terminal timestamp preceding launch accepted.");
+        Reject(() => Evaluate(exact with { ProcessCreatedAtUtc = ownStart.AddMilliseconds(20) }, exit with { ExitedAtUtc = ownStart.AddMilliseconds(10) }, now, _ => javaFixture), "Terminal timestamp preceding actual OS creation accepted.");
+        Reject(() => Evaluate(run, exit with { ExitedAtUtc = now.AddMinutes(2) }, now, _ => javaFixture), "Future terminal timestamp accepted.");
+        Reject(() => Evaluate(run with { ProcessId = 0 }, null, now, _ => javaFixture), "Invalid run PID accepted.");
+        var disk = Path.Combine(output, "matching-terminal"); Directory.CreateDirectory(disk);
+        File.WriteAllText(Path.Combine(disk, "exit.json"), JsonSerializer.Serialize(exit));
+        Check(Read(run, disk).State == "terminal", "Actual matching terminal file was not honored for own live non-Java PID.");
+        File.WriteAllText(Path.Combine(disk, "exit.json"), "{");
+        Reject(() => Read(run, disk), "Malformed terminal evidence was silently treated as active/absent.");
+        return new { status = "PASS", checks, ownProcessMetadataUsed = true, JavaIdentityCasesArePureFixtures = true,
+            validTerminalPreventsPidLookup = true, gameStartedOrAttached = false, processControlledOrKilled = false };
+    }
+}
diff --git a/tools/Atm9OriginalQa/Test-AgentSafety.ps1 b/tools/Atm9OriginalQa/Test-AgentSafety.ps1
new file mode 100644
index 0000000..f38b334
--- /dev/null
+++ b/tools/Atm9OriginalQa/Test-AgentSafety.ps1
@@ -0,0 +1,46 @@
+param(
+    [Parameter(Mandatory = $true)][string]$JdkHome,
+    [Parameter(Mandatory = $true)][string]$OutputDirectory
+)
+$ErrorActionPreference = 'Stop'
+$qaSafetyOutput = [IO.Path]::GetFullPath($OutputDirectory)
+if (($qaSafetyOutput -split '[\\/]') -notcontains 'artifacts') { throw 'QA test output must stay under artifacts.' }
+$qaSafetyAncestor = $qaSafetyOutput
+while ($qaSafetyAncestor) {
+    if ((Test-Path -LiteralPath $qaSafetyAncestor) -and
+        ((Get-Item -LiteralPath $qaSafetyAncestor -Force).Attributes -band [IO.FileAttributes]::ReparsePoint)) { throw 'Linked QA paths are forbidden.' }
+    $qaSafetyAncestor = [IO.Path]::GetDirectoryName($qaSafetyAncestor)
+}
+$qaSafetyJava = Join-Path $JdkHome 'bin/java.exe'
+$qaSafetyJavac = Join-Path $JdkHome 'bin/javac.exe'
+if (-not (Test-Path -LiteralPath $qaSafetyJava) -or -not (Test-Path -LiteralPath $qaSafetyJavac)) { throw 'A complete game JDK17 is required.' }
+New-Item -ItemType Directory -Path $qaSafetyOutput -Force | Out-Null
+$qaSafetyClasses = Join-Path $qaSafetyOutput 'classes'
+New-Item -ItemType Directory -Path $qaSafetyClasses -Force | Out-Null
+$qaSafetySources = @(Get-ChildItem -LiteralPath (Join-Path $PSScriptRoot 'tests') -Filter '*.java' -Recurse | ForEach-Object { $_.FullName })
+& $qaSafetyJavac --release 17 -encoding UTF-8 -d $qaSafetyClasses (Join-Path $PSScriptRoot 'QaLifecycleAgent.java') (Join-Path $PSScriptRoot 'NativeQaRequests.java') $qaSafetySources
+if ($LASTEXITCODE -ne 0) { throw 'QA safety test compilation failed.' }
+$qaSafetyLines = & $qaSafetyJava -cp $qaSafetyClasses QaAgentSafetyTest
+if ($LASTEXITCODE -ne 0) { throw 'QA safety test failed.' }
+$qaSafetyResult = $qaSafetyLines | ConvertFrom-Json
+if ($qaSafetyResult.status -ne 'PASS' -or $qaSafetyResult.javaFeature -ne 17 -or $qaSafetyResult.gameInteraction) { throw 'Invalid QA safety test result.' }
+$qaRequestLines = & $qaSafetyJava -cp $qaSafetyClasses QaNativeRequestSafetyTest (Join-Path $qaSafetyOutput 'request-fixtures')
+if ($LASTEXITCODE -ne 0) { throw 'QA native request safety test failed.' }
+$qaRequestResult = $qaRequestLines | ConvertFrom-Json
+if ($qaRequestResult.status -ne 'PASS' -or $qaRequestResult.javaFeature -ne 17 -or $qaRequestResult.gameInteraction) { throw 'Invalid native request safety result.' }
+$qaSafetyReport = [ordered]@{
+    checkedAtUtc = [DateTimeOffset]::UtcNow.ToString('o')
+    status = 'PASS'
+    javaExecutableSha256 = (Get-FileHash -LiteralPath $qaSafetyJava -Algorithm SHA256).Hash.ToLowerInvariant()
+    javaCompilerSha256 = (Get-FileHash -LiteralPath $qaSafetyJavac -Algorithm SHA256).Hash.ToLowerInvariant()
+    agentSourceSha256 = (Get-FileHash -LiteralPath (Join-Path $PSScriptRoot 'QaLifecycleAgent.java') -Algorithm SHA256).Hash.ToLowerInvariant()
+    testSourceSha256 = (Get-FileHash -LiteralPath (Join-Path $PSScriptRoot 'tests/QaAgentSafetyTest.java') -Algorithm SHA256).Hash.ToLowerInvariant()
+    nativeRequestsSourceSha256 = (Get-FileHash -LiteralPath (Join-Path $PSScriptRoot 'NativeQaRequests.java') -Algorithm SHA256).Hash.ToLowerInvariant()
+    nativeRequestsTestSourceSha256 = (Get-FileHash -LiteralPath (Join-Path $PSScriptRoot 'tests/QaNativeRequestSafetyTest.java') -Algorithm SHA256).Hash.ToLowerInvariant()
+    result = $qaSafetyResult
+    nativeRequestsResult = $qaRequestResult
+    runningGameInteraction = $false
+}
+$qaSafetyJson = $qaSafetyReport | ConvertTo-Json -Depth 5
+[IO.File]::WriteAllText((Join-Path $qaSafetyOutput 'safety-report.json'), $qaSafetyJson + "`n", [Text.UTF8Encoding]::new($false))
+$qaSafetyJson
