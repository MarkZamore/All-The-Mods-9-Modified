+import java.nio.charset.StandardCharsets;
+import java.nio.file.*;
+import java.util.*;
+
+/** Standalone fake worlds/connection only. Never packaged in the agent JAR. */
+public final class QaNativeRequestSafetyTest {
+    static final String WORLD = "ATM9QaRequestTests";
+    static final UUID UUID_QA = UUID.nameUUIDFromBytes("OfflinePlayer:ATM9Qa".getBytes(StandardCharsets.UTF_8));
+    static int checks;
+    static void check(boolean value, String message) { checks++; if (!value) throw new AssertionError(message); }
+    interface Checked { void run() throws Exception; }
+    static void rejected(Checked action, String message) {
+        boolean refused = false; try { action.run(); } catch (Exception expected) { refused = true; } check(refused, message);
+    }
+    static String quoted(String value) { return "\"" + value.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t") + "\""; }
+    static byte[] json(String id, String type, String value) {
+        return ("{\"protocol\":5,\"id\":" + quoted(id) + ",\"type\":" + quoted(type) + ",\"world\":" + quoted(WORLD) +
+            ",\"playerUuid\":" + quoted(UUID_QA.toString()) + ",\"text\":" + quoted(value) + "}").getBytes(StandardCharsets.UTF_8);
+    }
+    static void put(Path evidence, String id, String type, String text) throws Exception {
+        Files.createDirectories(evidence.resolve("native-requests")); Files.write(evidence.resolve("native-requests/" + id + ".json"), json(id, type, text));
+    }
+    public static final class FakePlayer {
+        UUID uuid = UUID_QA;
+        public UUID m_20148_() { return uuid; }
+    }
+    public static final class FakeWorldData {
+        Object name = WORLD;
+        public Object m_5462_() { return name; }
+    }
+    public static final class FakePlayerList {
+        List<FakePlayer> players = new ArrayList<>(List.of(new FakePlayer()));
+        public List<FakePlayer> m_11314_() { return players; }
+    }
+    public static final class FakeServer {
+        Object published = false;
+        final FakeWorldData data = new FakeWorldData();
+        final FakePlayerList players = new FakePlayerList();
+        public Object m_6992_() { return published; }
+        public FakeWorldData m_129910_() { return data; }
+        public FakePlayerList m_6846_() { return players; }
+    }
+    public static final class FakeConnection {
+        final List<String> chat = new ArrayList<>(), command = new ArrayList<>();
+        boolean fail; int attempts;
+        FakeTransport transport = new FakeTransport();
+        public FakeTransport m_104910_() { return transport; }
+        public void m_246175_(String value) throws Exception { attempts++; if (fail) throw new java.io.IOException("fake post-claim dispatch failure"); chat.add(value); }
+        public void m_246623_(String value) throws Exception { attempts++; if (fail) throw new java.io.IOException("fake post-claim dispatch failure"); command.add(value); }
+    }
+    public static final class FakeTransport {
+        Object memory = true;
+        public Object m_129531_() { return memory; }
+    }
+    public static final class FakeClient {
+        public Object f_91074_ = new FakePlayer(), f_91073_ = new Object(), f_91080_;
+        Object overlay;
+        FakeServer server = new FakeServer();
+        FakeConnection connection = new FakeConnection();
+        public Object m_91265_() { return overlay; }
+        public FakeServer m_91092_() { return server; }
+        public FakeConnection m_91403_() { return connection; }
+    }
+    static final class Events implements NativeQaRequests.Events {
+        final List<String> kinds = new ArrayList<>();
+        public void write(String kind, Map<String, ?> values) { kinds.add(kind); }
+    }
+    public static void main(String[] args) throws Exception {
+        check(Runtime.version().feature() == 17, "Actual game JDK17 required");
+        Path root = Path.of(args[0]).toAbsolutePath(); check(!Files.exists(root), "Use new standalone fake output"); Files.createDirectories(root);
+        var parsed = NativeQaRequests.parse(json("valid", "chat", "Верити, ответь по-русски."), "valid.json");
+        check(parsed.text().equals("Верити, ответь по-русски.") && parsed.playerUuid().equals(UUID_QA), "UTF8 request changed");
+        var escaped = new String(json("valid", "chat", "test"), StandardCharsets.UTF_8).replace("test", "\\u0412\\u0435\\u0440\\u0438\\u0442\\u0438");
+        check(NativeQaRequests.parse(escaped.getBytes(StandardCharsets.UTF_8), "valid.json").text().equals("Верити"), "JSON Unicode escapes changed");
+        for (String text : List.of("", " ", "/give @s minecraft:stone", "a/b", "a\nb", "a\rb", "a\tb", "a\0b", "a\u2028b", "a\u2029b", "я".repeat(257), "\uD800", "\uDC00"))
+            check(!NativeQaRequests.validChat(text), "Unsafe plain chat accepted");
+        for (String text : List.of("Верити, привет!", "я".repeat(256), "Проверка 🙂")) check(NativeQaRequests.validChat(text), "Safe chat rejected");
+        for (String text : List.of("give @s verity:verity_item", "give @s minecraft:stone 1", "give @s test:path/item 64")) check(NativeQaRequests.validCommand(text), "Safe give rejected");
