+    /** Exact native 1.20.1 SRG signatures verified against the pinned client JAR. */
+    static final class NativeRequestTarget implements NativeQaRequests.Target {
+        private final Object client;
+        NativeRequestTarget(Object client) { this.client = client; }
+        public NativeQaRequests.Facts inspect() throws Exception {
+            Class<?> mc = client.getClass();
+            Object player = field(mc, "f_91074_").get(client), level = field(mc, "f_91073_").get(client);
+            Object screen = field(mc, "f_91080_").get(client), overlay = method(mc, "m_91265_").invoke(client);
+            Object server = method(mc, "m_91092_").invoke(client);
+            if (!healthStage(player, level, screen, overlay, server).equals("integrated_world")) return null;
+            Object connection = method(mc, "m_91403_").invoke(client);
+            if (connection == null) return null;
+            Object transport = method(connection.getClass(), "m_104910_").invoke(connection);
+            if (transport == null) return null;
+            Object memory = method(transport.getClass(), "m_129531_").invoke(transport);
+            Object published = method(server.getClass(), "m_6992_").invoke(server);
+            Object data = method(server.getClass(), "m_129910_").invoke(server);
+            Object name = method(data.getClass(), "m_5462_").invoke(data);
+            UUID uuid = (UUID) method(player.getClass(), "m_20148_").invoke(player);
+            Object playerList = method(server.getClass(), "m_6846_").invoke(server);
