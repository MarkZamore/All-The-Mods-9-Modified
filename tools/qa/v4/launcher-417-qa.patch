+    // Inspect the hierarchy of an existing instance; no Class.forName, game
+    // constructor or static initializer is needed to recognize native screens.
+    static String healthStage(Object player, Object level, Object screen, Object overlay, Object server) {
+        if (overlay != null) return "none";
+        if (player == null && level == null && server == null && hasType(screen, "net.minecraft.client.gui.screens.TitleScreen")) return "title";
+        if (player != null && level != null && server != null && screen == null) return "integrated_world";
+        return "none";
+    }
+
+    private static boolean hasType(Object value, String name) {
+        if (value == null) return false;
+        for (Class<?> type = value.getClass(); type != null; type = type.getSuperclass())
+            if (type.getName().equals(name)) return true;
+        return false;
+    }
+
+    static final class HealthSamples {
+        int titleSamples, worldSamples;
+        void accept(String stage) {
+            titleSamples = stage.equals("title") ? titleSamples + 1 : 0;
+            worldSamples = stage.equals("integrated_world") ? worldSamples + 1 : 0;
+        }
+        boolean stableTitle() { return titleSamples >= 3; }
+        boolean stableWorld() { return worldSamples >= 3; }
+    }
+
+    static int observationTimeout(String value) {
+        int minutes = Integer.parseInt(value);
+        if (minutes < 1 || minutes > 120) throw new IllegalArgumentException("QA observation timeout must be 1..120 minutes");
+        return minutes;
+    }
+
+    /** JDK metadata query only: true exclusively after successful full clinit. */
+    static final class InitializationGate {
+        private final Object unsafe;
+        private final Method shouldBeInitialized;
+        InitializationGate() throws ReflectiveOperationException {
+            Class<?> type = Class.forName("sun.misc.Unsafe");
+            Field singleton = type.getDeclaredField("theUnsafe"); singleton.setAccessible(true);
+            unsafe = singleton.get(null); shouldBeInitialized = type.getMethod("shouldBeInitialized", Class.class);
+        }
+        boolean isInitialized(Class<?> type) throws ReflectiveOperationException {
+            return !((Boolean) shouldBeInitialized.invoke(unsafe, type));
+        }
+    }
+
+    /** Read-only and called on the render executor only after native health. */
+    static final class NativeGpuProbe {
+        static Map<String, Object> sampleIfHealthy(HealthSamples samples, ClassLoader loader) throws ReflectiveOperationException {
+            if (!samples.stableTitle() && !samples.stableWorld()) return null;
+            var result = new LinkedHashMap<String, Object>();
+            result.put("gpuStateChanged", false);
+            result.put("visualVerificationClaimed", false);
+            Class<?> glfw = Class.forName("org.lwjgl.glfw.GLFW", false, loader);
+            long context = (Long) glfw.getMethod("glfwGetCurrentContext").invoke(null);
+            result.put("nativeCurrentContextPresent", context != 0);
+            if (context == 0) { result.put("gpuLimitVerified", false); return result; }
+            Class<?> gl11 = Class.forName("org.lwjgl.opengl.GL11", false, loader);
+            Method integer = gl11.getMethod("glGetInteger", int.class);
+            Method string = gl11.getMethod("glGetString", int.class);
+            int maximum = (Integer) integer.invoke(null, 3379); // GL_MAX_TEXTURE_SIZE
+            String vendor = (String) string.invoke(null, 7936); // GL_VENDOR
+            String renderer = (String) string.invoke(null, 7937); // GL_RENDERER
+            String version = (String) string.invoke(null, 7938); // GL_VERSION
+            result.put("maxTextureSize", maximum);
+            result.put("vendor", String.valueOf(vendor)); result.put("renderer", String.valueOf(renderer));
+            result.put("version", String.valueOf(version));
+            result.put("gpuLimitVerified", maximum > 0 && vendor != null && renderer != null && version != null);
+            return result;
+        }
+    }
+
+    /** Optional bounded read of the actual selected client resource, no files written. */
+    static final class NativeResourceProbe {
+        static final int BYTE_LIMIT = 1024 * 1024;
+        static boolean validResourceId(String value) {
+            if (value == null || value.length() > 256 || !value.matches("[a-z0-9_.-]+:[a-z0-9_./-]+")) return false;
+            String path = value.substring(value.indexOf(':') + 1);
+            if (path.startsWith("/")) return false;
+            for (String segment : path.split("/", -1)) if (segment.isEmpty() || segment.equals(".") || segment.equals("..")) return false;
+            return true;
+        }
+        static Map<String, Object> sampleIfHealthy(HealthSamples samples, Object client, String id) throws Exception {
+            if (!samples.stableTitle() && !samples.stableWorld()) return null;
+            if (!validResourceId(id)) throw new IllegalArgumentException("Invalid resource probe ID");
+            var result = new LinkedHashMap<String, Object>();
+            result.put("resourceId", id); result.put("byteLimit", BYTE_LIMIT); result.put("resourceChanged", false);
+            // These exact 1.20.1 SRG signatures are verified with javap on the
+            // pinned client JAR. No early bootstrap resource class lookup.
+            Object manager = method(client.getClass(), "m_91098_").invoke(client);
+            Class<?> location = Class.forName("net.minecraft.resources.ResourceLocation", false, client.getClass().getClassLoader());
+            Object name = location.getConstructor(String.class).newInstance(id);
+            Optional<?> found = (Optional<?>) manager.getClass().getMethod("m_213713_", location).invoke(manager, name);
+            result.put("resourceFound", found.isPresent());
+            if (found.isEmpty()) return result;
+            Object resource = found.get();
+            String pack = String.valueOf(resource.getClass().getMethod("m_215506_").invoke(resource));
+            // Pack IDs are diagnostic names, not permission to print a local path.
+            if (pack.matches("^[A-Za-z]:[\\\\/].*") || pack.startsWith("/") || pack.contains("\\"))
+                result.put("sourcePackIdRedactedAsPath", true);
+            else result.put("sourcePackId", pack.length() <= 512 ? pack : "<oversized pack ID>");
+            byte[] bytes;
+            try (InputStream input = (InputStream) resource.getClass().getMethod("m_215507_").invoke(resource)) {
+                bytes = input.readNBytes(BYTE_LIMIT + 1);
+                if (bytes.length > BYTE_LIMIT) throw new IOException("Resource probe exceeds " + BYTE_LIMIT + " byte limit");
+            }
+            result.put("sizeBytes", bytes.length);
+            result.put("sha256", HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(bytes)));
+            return result;
+        }
+    }
+
     private void createFresh(Object client) throws Exception {
         if (Files.exists(game.resolve("saves").resolve(freshWorld), LinkOption.NOFOLLOW_LINKS))
             throw new SecurityException("Fresh world collision before native creation");
