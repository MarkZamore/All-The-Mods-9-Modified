+import java.lang.invoke.MethodHandles;
+import java.lang.invoke.MethodType;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+
+/** Runs in a separate tiny JVM; no game, attach API, flags or GUI are used. */
+public final class QaAgentSafetyTest {
+    static final class Tracker {
+        static final AtomicInteger cold = new AtomicInteger();
+        static final AtomicInteger progress = new AtomicInteger();
+        static final AtomicInteger failed = new AtomicInteger();
+        static final CountDownLatch entered = new CountDownLatch(1);
+        static final CountDownLatch release = new CountDownLatch(1);
+        static volatile boolean failNow = true;
+    }
+
+    public static final class Cold {
+        static { Tracker.cold.incrementAndGet(); }
+        public static int value() { return Tracker.cold.get(); }
+    }
+
+    static final class InProgress {
+        static {
+            Tracker.progress.incrementAndGet(); Tracker.entered.countDown();
+            try {
+                if (!Tracker.release.await(10, TimeUnit.SECONDS)) throw new AssertionError("Initializer release timed out");
+            } catch (InterruptedException failure) { throw new AssertionError(failure); }
+        }
+    }
+
+    static final class Failed {
+        static {
+            Tracker.failed.incrementAndGet();
+            if (Tracker.failNow) throw new IllegalStateException("Expected failing initializer");
+        }
+    }
+
+    static final class ExtendedMenuScreen extends net.minecraft.client.gui.screens.TitleScreen { }
+    static final class LoadingScreen { }
+    static final class ErrorScreen { }
+
+    public static final class FakeResourceClient {
+        final FakeResourceManager manager = new FakeResourceManager();
+        int managerQueries;
+        public Object m_91098_() { managerQueries++; return manager; }
+    }
+    public static final class FakeResourceManager {
+        FakeResource resource;
+        int queries;
+        public java.util.Optional<FakeResource> m_213713_(net.minecraft.resources.ResourceLocation id) {
+            queries++; return java.util.Optional.ofNullable(resource);
+        }
+    }
+    public static final class FakeResource {
+        final byte[] bytes;
+        final String pack;
+        boolean closed;
+        FakeResource(byte[] bytes, String pack) { this.bytes = bytes; this.pack = pack; }
+        public String m_215506_() { return pack; }
+        public java.io.InputStream m_215507_() {
+            return new java.io.ByteArrayInputStream(bytes) {
+                @Override public void close() throws java.io.IOException { closed = true; super.close(); }
+            };
+        }
+    }
+
+    private static int checks;
+    private static void check(boolean value, String message) {
+        checks++;
+        if (!value) throw new AssertionError(message);
+    }
+
+    public static void main(String[] args) throws Throwable {
+        check(Runtime.version().feature() == 17, "Safety validation must use the actual game JDK17");
+        var gate = new QaLifecycleAgent.InitializationGate();
+        check(Tracker.cold.get() == 0, "Cold fixture initialized before test");
+        Class<?> cold = Cold.class;
+        for (int i = 0; i < 100; i++) check(!gate.isInitialized(cold), "Cold class incorrectly treated as initialized");
+        check(Tracker.cold.get() == 0, "Initialized-state query ran cold clinit");
+        var getter = MethodHandles.publicLookup().findStatic(cold, "value", MethodType.methodType(int.class));
+        check(!gate.isInitialized(cold) && Tracker.cold.get() == 0, "Single-signature method lookup initialized cold class");
+        Class.forName(cold.getName(), true, cold.getClassLoader());
+        check(gate.isInitialized(cold) && Tracker.cold.get() == 1, "Successful clinit was not recognized");
+        check((int) getter.invokeExact() == 1 && Tracker.cold.get() == 1, "Guarded method invoked clinit a second time");
+
+        Class<?> progress = InProgress.class;
+        check(!gate.isInitialized(progress) && Tracker.progress.get() == 0, "Progress fixture initialized before request");
+        var initializerFailure = new java.util.concurrent.atomic.AtomicReference<Throwable>();
+        Thread initializer = new Thread(() -> {
+            try { Class.forName(progress.getName(), true, progress.getClassLoader()); }
+            catch (Throwable failure) { initializerFailure.set(failure); }
+        }, "QA-initialization-test");
+        initializer.start();
+        try {
+            check(Tracker.entered.await(5, TimeUnit.SECONDS), "In-progress initializer did not start");
+            for (int i = 0; i < 100; i++) check(!gate.isInitialized(progress), "In-progress clinit incorrectly treated as complete");
+            check(Tracker.progress.get() == 1 && initializer.isAlive(), "Query advanced or repeated in-progress clinit");
+        } finally { Tracker.release.countDown(); initializer.join(5000); }
+        check(!initializer.isAlive() && initializerFailure.get() == null, "Initializer did not finish cleanly");
+        check(gate.isInitialized(progress) && Tracker.progress.get() == 1, "Finished initializer was not recognized");
+
+        Class<?> failed = Failed.class;
+        check(!gate.isInitialized(failed) && Tracker.failed.get() == 0, "Failure fixture initialized before request");
+        boolean failedAsExpected = false;
+        try { Class.forName(failed.getName(), true, failed.getClassLoader()); }
+        catch (ExceptionInInitializerError expected) { failedAsExpected = true; }
+        check(failedAsExpected && Tracker.failed.get() == 1, "Failure fixture did not fail exactly once");
+        for (int i = 0; i < 100; i++) check(!gate.isInitialized(failed), "Failed clinit incorrectly treated as successful");
+        check(Tracker.failed.get() == 1, "Query retried a failed initializer");
+
+        Object title = new ExtendedMenuScreen(), loading = new LoadingScreen(), error = new ErrorScreen();
+        Object player = new Object(), level = new Object(), server = new Object(), overlay = new Object();
+        check(QaLifecycleAgent.healthStage(null, null, title, null, null).equals("title"), "Title subclass not recognized");
+        check(QaLifecycleAgent.healthStage(null, null, title, overlay, null).equals("none"), "Title with loading overlay counted healthy");
+        check(QaLifecycleAgent.healthStage(null, null, loading, null, null).equals("none"), "Loading screen counted healthy");
+        check(QaLifecycleAgent.healthStage(null, null, error, null, null).equals("none"), "Error screen counted healthy");
+        check(QaLifecycleAgent.healthStage(null, null, null, null, null).equals("none"), "Missing screen/instance state counted healthy");
+        check(QaLifecycleAgent.healthStage(player, level, title, null, server).equals("none"), "Title with active world counted healthy");
+        check(QaLifecycleAgent.healthStage(player, level, null, null, server).equals("integrated_world"), "Joined integrated world not recognized");
+        check(QaLifecycleAgent.healthStage(player, level, loading, null, server).equals("none"), "World loading screen counted healthy");
+        check(QaLifecycleAgent.healthStage(player, level, error, null, server).equals("none"), "World error screen counted healthy");
+        check(QaLifecycleAgent.healthStage(player, level, null, overlay, server).equals("none"), "World overlay counted healthy");
+        check(QaLifecycleAgent.healthStage(player, null, null, null, server).equals("none"), "Missing world level counted healthy");
+        check(QaLifecycleAgent.healthStage(player, level, null, null, null).equals("none"), "Missing integrated server counted healthy");
+
+        var samples = new QaLifecycleAgent.HealthSamples();
+        samples.accept("title"); samples.accept("title");
+        check(!samples.stableTitle(), "Two title observations counted as three");
+        samples.accept("none"); samples.accept("title"); samples.accept("title");
+        check(!samples.stableTitle(), "Loading/error interruption did not reset title samples");
+        samples.accept("title");
+        check(samples.stableTitle() && !samples.stableWorld(), "Three native title samples not accepted");
+        samples.accept("integrated_world"); samples.accept("integrated_world");
+        check(!samples.stableTitle() && !samples.stableWorld(), "Transition retained stale native health");
+        samples.accept("none"); samples.accept("integrated_world"); samples.accept("integrated_world");
+        check(!samples.stableWorld(), "Loading/error interruption did not reset world samples");
+        samples.accept("integrated_world");
+        check(samples.stableWorld(), "Three joined-world samples not accepted");
+
+        check(QaLifecycleAgent.observationTimeout("1") == 1 && QaLifecycleAgent.observationTimeout("120") == 120, "Deadline bounds rejected");
+        for (String invalid : new String[] { "0", "121", "-1", "NaN" }) {
+            boolean rejected = false;
+            try { QaLifecycleAgent.observationTimeout(invalid); }
+            catch (IllegalArgumentException expected) { rejected = true; }
+            check(rejected, "Invalid observation deadline accepted: " + invalid);
+        }
+        var gpuHealth = new QaLifecycleAgent.HealthSamples();
+        ClassLoader testLoader = QaAgentSafetyTest.class.getClassLoader();
+        check(org.lwjgl.QaGpuTracker.glfwInitializers == 0 && org.lwjgl.QaGpuTracker.gl11Initializers == 0, "Fake GL initialized before any probe");
+        check(QaLifecycleAgent.NativeGpuProbe.sampleIfHealthy(gpuHealth, testLoader) == null, "GPU read before native health");
+        gpuHealth.accept("title"); gpuHealth.accept("title");
+        check(QaLifecycleAgent.NativeGpuProbe.sampleIfHealthy(gpuHealth, testLoader) == null, "GPU read after only two title samples");
+        gpuHealth.accept("none");
+        check(QaLifecycleAgent.NativeGpuProbe.sampleIfHealthy(gpuHealth, testLoader) == null, "GPU read on loading/error interruption");
+        check(org.lwjgl.QaGpuTracker.glfwInitializers == 0 && org.lwjgl.QaGpuTracker.gl11Initializers == 0 && org.lwjgl.QaGpuTracker.contextQueries == 0, "GPU class load/query escaped health guard");
+        gpuHealth.accept("title"); gpuHealth.accept("title"); gpuHealth.accept("title");
+        var noContext = QaLifecycleAgent.NativeGpuProbe.sampleIfHealthy(gpuHealth, testLoader);
+        check(noContext.get("nativeCurrentContextPresent").equals(false) && noContext.get("gpuLimitVerified").equals(false), "Absent native context incorrectly verified");
+        check(org.lwjgl.QaGpuTracker.contextQueries == 1 && org.lwjgl.QaGpuTracker.gl11Initializers == 0, "GL11 loaded without a current context");
+        check(org.lwjgl.QaGpuTracker.integerQueries == 0 && org.lwjgl.QaGpuTracker.stringQueries == 0, "GL queries ran without context");
+        org.lwjgl.QaGpuTracker.context = 42;
+        var gpu = QaLifecycleAgent.NativeGpuProbe.sampleIfHealthy(gpuHealth, testLoader);
+        check(gpu.get("nativeCurrentContextPresent").equals(true) && gpu.get("gpuLimitVerified").equals(true), "Current context not recognized");
+        check(gpu.get("maxTextureSize").equals(16384) && gpu.get("vendor").equals("standalone fake vendor"), "Authorized GPU metadata not read");
+        check(org.lwjgl.QaGpuTracker.integerQueries == 1 && org.lwjgl.QaGpuTracker.stringQueries == 3, "GPU probe issued extra/missing enum queries");
+        check(gpu.get("gpuStateChanged").equals(false) && gpu.get("visualVerificationClaimed").equals(false), "GPU read claimed a state/visual change");
+        for (String invalid : new String[] { "../secret", "x:../a", "x:/a", "x:a//b", "X:a", "x:a/./b", "C:\\secret" })
+            check(!QaLifecycleAgent.NativeResourceProbe.validResourceId(invalid), "Unsafe resource ID accepted: " + invalid);
+        check(QaLifecycleAgent.NativeResourceProbe.validResourceId("fixture:textures/gui/title.png"), "Valid generic resource ID rejected");
