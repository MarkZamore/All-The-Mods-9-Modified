+            check(!NativeQaRequests.validCommand(text), "Unsafe command accepted");
+        for (String id : List.of("../bad", "A", "", "a/b", "a\\b", ".hidden", "a".repeat(65))) check(!NativeQaRequests.validId(id), "Unsafe ID accepted");
+        String valid = new String(json("valid", "chat", "test"), StandardCharsets.UTF_8);
+        for (String invalid : List.of(valid.replace("\"protocol\":5", "\"protocol\":4"), valid.replace("\"protocol\":5", "\"protocol\":\"5\""),
+                valid.replace("\"protocol\":5", "\"protocol\":5,\"protocol\":5"), valid.replace("\"protocol\":5", "\"protocol\":5,\"unknown\":\"x\""),
+                valid.replace("\"type\":\"chat\"", "\"type\":\"button\""), valid.replace(WORLD, "PersonalWorld"), valid.replace(UUID_QA.toString(), UUID_QA.toString().toUpperCase()),
+                valid.replace("test", "\\u+041"), valid + "{}", valid.replace("\"text\":\"test\"", "\"text\":{}")))
+            rejected(() -> NativeQaRequests.parse(invalid.getBytes(StandardCharsets.UTF_8), "valid.json"), "Malformed schema accepted");
+        rejected(() -> NativeQaRequests.parse(json("valid", "chat", "test"), "different.json"), "Filename binding ignored");
+        rejected(() -> NativeQaRequests.parse(new byte[4097], "valid.json"), "Byte bound ignored");
+        rejected(() -> NativeQaRequests.parse(new byte[] {(byte) 0xc3, 0x28}, "valid.json"), "Malformed UTF8 accepted");
+        var facts = new NativeQaRequests.Facts(WORLD, UUID_QA, false, List.of(UUID_QA), true);
+        NativeQaRequests.requireScope(parsed, WORLD, UUID_QA, facts); check(true, "Valid private scope");
+        for (var bad : List.of(new NativeQaRequests.Facts("PersonalWorld", UUID_QA, false, List.of(UUID_QA), true),
