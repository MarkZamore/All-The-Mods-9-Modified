new file mode 100644
index 0000000..0bbccfc
--- /dev/null
+++ b/tools/Atm9OriginalQa/QaProcessIdentity.cs
@@ -0,0 +1,116 @@
+using System.Diagnostics;
+using System.IO;
+using System.Text.Json;
+
+record Run(int ProcessId, DateTimeOffset StartedAtUtc, string GameDirectory, string Mode, string Label,
+    DateTimeOffset? ProcessCreatedAtUtc = null, string? ExpectedProcessName = null);
+record QaExit(int ProcessId, int ExitCode, DateTimeOffset ExitedAtUtc);
+record QaProcessSnapshot(string Name, DateTimeOffset CreatedAtUtc, bool HasExited);
+record QaProcessStatus(bool IsRunning, string State, string Authority,
+    DateTimeOffset? ObservedCreatedAtUtc = null, string? ObservedProcessName = null);
+
+// Read-only process metadata. No attach, input, termination or process-tree operations.
+static class QaProcessIdentity
+{
+    private static readonly JsonSerializerOptions Json = new() { PropertyNameCaseInsensitive = true };
+
+    public static QaProcessStatus Read(Run run, string evidence)
+    {
+        var exitPath = Path.Combine(evidence, "exit.json");
+        QaExit? terminal = null;
+        if (File.Exists(exitPath))
+        {
+            try { terminal = JsonSerializer.Deserialize<QaExit>(File.ReadAllText(exitPath), Json) ?? throw new JsonException("Empty exit record."); }
+            catch (JsonException failure) { throw new IOException("QA exit.json is incomplete or malformed. Wait for its writer or review this fixture; no control marker was written.", failure); }
+        }
+        return Evaluate(run, terminal, DateTimeOffset.UtcNow, ReadProcess);
+    }
+
+    internal static QaProcessStatus Evaluate(Run run, QaExit? terminal, DateTimeOffset now, Func<int, QaProcessSnapshot?> resolve)
+    {
+        if (run.ProcessId <= 0 || run.StartedAtUtc == default || run.StartedAtUtc > now.AddMinutes(1))
+            throw new IOException("QA run.json has an invalid process ID or launch timestamp; review this fixture before controlling it.");
+        if (terminal is not null)
+        {
+            if (terminal.ProcessId != run.ProcessId || terminal.ExitedAtUtc < (run.ProcessCreatedAtUtc ?? run.StartedAtUtc) || terminal.ExitedAtUtc > now.AddMinutes(1))
+                throw new IOException("QA exit.json does not match run.json process ID/time. Review the conflicting evidence; no control marker was written.");
+            // Do not query a historical PID: Windows may have reused it or may
+            // retain a terminated process object while another reader holds it.
+            return new(false, "terminal", "matching exit.json");
+        }
+        var actual = resolve(run.ProcessId);
+        if (actual is null) return new(false, "absent", "process metadata");
+        if (!IsJava(actual.Name) || (run.ExpectedProcessName is not null &&
+            !actual.Name.Equals(run.ExpectedProcessName, StringComparison.OrdinalIgnoreCase)))
+            return new(false, "process-name-mismatch", "PID is not the recorded QA Java", actual.CreatedAtUtc, actual.Name);
+        var expectedStart = run.ProcessCreatedAtUtc ?? run.StartedAtUtc;
+        // New records retain the actual OS creation time. Legacy records were
+        // stamped just before CreateProcess and need a small launch tolerance.
+        var tolerance = run.ProcessCreatedAtUtc is null ? TimeSpan.FromSeconds(2) : TimeSpan.FromMilliseconds(1);
+        if ((actual.CreatedAtUtc - expectedStart).Duration() > tolerance)
+            return new(false, "process-start-mismatch", "PID is not the recorded QA Java", actual.CreatedAtUtc, actual.Name);
+        return new(!actual.HasExited, actual.HasExited ? "exited" : "active", "matching Java name and OS creation time", actual.CreatedAtUtc, actual.Name);
+    }
+
+    private static bool IsJava(string name) => name.Equals("java", StringComparison.OrdinalIgnoreCase) || name.Equals("javaw", StringComparison.OrdinalIgnoreCase);
+
+    private static QaProcessSnapshot? ReadProcess(int pid)
+    {
+        Process process;
+        try { process = Process.GetProcessById(pid); }
+        catch (ArgumentException) { return null; }
+        using (process)
+        {
+            try { return new(process.ProcessName, new DateTimeOffset(process.StartTime.ToUniversalTime()), process.HasExited); }
+            catch (Exception failure) when (failure is InvalidOperationException or System.ComponentModel.Win32Exception)
+            {
+                throw new IOException("Cannot verify the recorded QA Java process identity. Retry the same fixture or inspect its exit evidence; no control marker was written.", failure);
+            }
+        }
+    }
+
+    public static object SelfTest(string output)
+    {
+        if (Directory.Exists(output)) throw new IOException("Use a new artifacts output for the process identity self-test.");
+        Directory.CreateDirectory(output);
+        using var own = Process.GetCurrentProcess();
+        var now = DateTimeOffset.UtcNow;
+        var ownStart = new DateTimeOffset(own.StartTime.ToUniversalTime());
+        var run = new Run(own.Id, ownStart, "standalone CLI self-test", "self-test", "identity");
+        var ownSnapshot = new QaProcessSnapshot(own.ProcessName, ownStart, own.HasExited);
+        var checks = 0;
+        void Check(bool condition, string reason) { checks++; if (!condition) throw new InvalidOperationException(reason); }
+        void Reject(Action action, string reason)
+        {
+            var rejected = false;
+            try { action(); } catch (IOException) { rejected = true; }
+            Check(rejected, reason);
+        }
+        Check(!Evaluate(run, null, now, _ => ownSnapshot).IsRunning, "Own dotnet test process must not be accepted as QA Java.");
+        var javaFixture = new QaProcessSnapshot("javaw", ownStart, false);
+        Check(Evaluate(run, null, now, _ => javaFixture).IsRunning, "Matching legacy Java identity rejected.");
+        Check(!Evaluate(run, null, now, _ => javaFixture with { CreatedAtUtc = ownStart.AddSeconds(3) }).IsRunning, "Reused PID with different start time accepted.");
+        Check(!Evaluate(run, null, now, _ => javaFixture with { Name = "unrelated" }).IsRunning, "Reused PID with different image accepted.");
+        Check(!Evaluate(run, null, now, _ => null).IsRunning, "Missing PID accepted as active.");
+        var exact = run with { ProcessCreatedAtUtc = ownStart, ExpectedProcessName = "javaw" };
+        Check(Evaluate(exact, null, now, _ => javaFixture).IsRunning, "Matching exact creation time rejected.");
+        Check(!Evaluate(exact, null, now, _ => javaFixture with { CreatedAtUtc = ownStart.AddMilliseconds(2) }).IsRunning, "Different exact creation time accepted.");
+        Check(!Evaluate(exact, null, now, _ => javaFixture with { Name = "java" }).IsRunning, "Different recorded Java executable name accepted.");
+        var exit = new QaExit(own.Id, 0, now);
+        var lookups = 0;
+        var terminal = Evaluate(run, exit, now, _ => { lookups++; throw new InvalidOperationException("Historical PID must never be resolved."); });
+        Check(!terminal.IsRunning && terminal.State == "terminal" && lookups == 0, "Matching exit did not take precedence over a potentially reused PID.");
+        Reject(() => Evaluate(run, exit with { ProcessId = own.Id + 1 }, now, _ => javaFixture), "Mismatched terminal PID accepted.");
+        Reject(() => Evaluate(run, exit with { ExitedAtUtc = ownStart.AddTicks(-1) }, now, _ => javaFixture), "Terminal timestamp preceding launch accepted.");
+        Reject(() => Evaluate(exact with { ProcessCreatedAtUtc = ownStart.AddMilliseconds(20) }, exit with { ExitedAtUtc = ownStart.AddMilliseconds(10) }, now, _ => javaFixture), "Terminal timestamp preceding actual OS creation accepted.");
+        Reject(() => Evaluate(run, exit with { ExitedAtUtc = now.AddMinutes(2) }, now, _ => javaFixture), "Future terminal timestamp accepted.");
+        Reject(() => Evaluate(run with { ProcessId = 0 }, null, now, _ => javaFixture), "Invalid run PID accepted.");
+        var disk = Path.Combine(output, "matching-terminal"); Directory.CreateDirectory(disk);
+        File.WriteAllText(Path.Combine(disk, "exit.json"), JsonSerializer.Serialize(exit));
+        Check(Read(run, disk).State == "terminal", "Actual matching terminal file was not honored for own live non-Java PID.");
+        File.WriteAllText(Path.Combine(disk, "exit.json"), "{");
+        Reject(() => Read(run, disk), "Malformed terminal evidence was silently treated as active/absent.");
+        return new { status = "PASS", checks, ownProcessMetadataUsed = true, JavaIdentityCasesArePureFixtures = true,
+            validTerminalPreventsPidLookup = true, gameStartedOrAttached = false, processControlledOrKilled = false };
+    }
+}
